# Copy to `.env` and fill in the values. .env is gitignored.
# On the Pi it is read by python-dotenv AND by the systemd units'
# EnvironmentFile= line, so keep one KEY=value per line, comments on
# their own lines, and no `export`.

# ---- Required ---------------------------------------------------------

# Anthropic Claude API key, used by admin_bot.py for the WhatsApp bot.
ANTHROPIC_API_KEY=sk-ant-api03-...

# CourtReserve (the club's member portal) login.
# URL is the portal index page; find the numeric suffix on your own club's URL.
COURTRESERVE_URL=https://app.courtreserve.com/Online/Portal/Index/XXXX
COURTRESERVE_USERNAME=you@example.com
COURTRESERVE_PASSWORD=your-password

# Google Sheet that acts as the player roster (also holds the Session
# log, Pair log and Usage log tabs).
# See docs/google_sheets_setup.md for how to get the ID.
GOOGLE_SHEET_ID=your-sheet-id-here

# ---- Optional: extra CourtReserve accounts ----------------------------

# Only needed if accounts.json exists (multi-account mode, see
# accounts.py). Each account names its own credential variables there
# via cr_username_env / cr_password_env, for example:
# COURTRESERVE_USERNAME_SHIRLEY=someone@example.com
# COURTRESERVE_PASSWORD_SHIRLEY=their-password

# ---- Optional: email alerts -------------------------------------------

# Used by admin_bot.py and scripts/boris_daily_canary.py to email an
# alert when something fails. Leave unset to disable email. Gmail needs
# an app password, not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=you@example.com
# Minimum seconds between repeat alerts of the same kind from the bot
# (default 300).
# ALERT_RATE_LIMIT_SECONDS=300

# ---- Optional: watchdog (scripts/boris_watchdog.sh) -------------------

# WhatsApp group JID to post "bridge recovered" notices to. Unset means
# recoveries are only logged to the journal.
# ADMIN_GROUP_JID=1203630000000000000@g.us
# Outage length (seconds) before a recovery notice is posted (default 300).
# NOTIFY_THRESHOLD_SECS=300
# Restart the bot if its heartbeat file is older than this (default 1200).
# BOT_STALE_SECS=1200
# Also overridable, rarely needed: BOT_HEARTBEAT, STATE_FILE,
# LOCKED_OUT_SENTINEL, LOCKED_OUT_LOOKBACK (see the script header).

# ---- Optional: daily canary (scripts/boris_daily_canary.py) -----------

# Group the canary posts its test message to (defaults to the Boris
# admin group).
# BORIS_GROUP_JID=1203630000000000000@g.us
# Per-send timeout, and how long / how often to retry a failed send
# before alerting (defaults 15, 300 and 30 seconds).
# SEND_TIMEOUT_SECONDS=15
# CANARY_RETRY_WINDOW_SECONDS=300
# CANARY_RETRY_INTERVAL_SECONDS=30

# ---- Optional: shared ------------------------------------------------

# WhatsApp bridge base URL for the watchdog and canary (default
# http://127.0.0.1:8080). admin_bot.py uses a fixed URL and ignores this.
# BRIDGE_URL=http://127.0.0.1:8080

# ---- Testing only -----------------------------------------------------

# ISO timestamp that scheduled_bookings.py treats as "now" when deciding
# whether a booking window has opened. Never set this in production.
# BORIS_BOOKING_OVERRIDE_OPENS_AT=2026-01-01T07:00:00
